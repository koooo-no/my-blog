---
import { SITE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import { withBase, stripBase } from '../utils/url';

const path = stripBase(Astro.url.pathname).replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const clean = href.replace(/\/+$/, '') || '/';
  if (clean === '/') return path === '/';
  return path === clean || path.startsWith(clean + '/');
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href={withBase('/')} class="brand" aria-label={SITE.title}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a href={withBase(item.href)} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
      <a
        href={withBase('/search')}
        class:list={['search-link', { active: isActive('/search') }]}
        aria-label="搜索"
        title="搜索（按 / 键）"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<script is:inline define:vars={{ searchUrl: withBase('/search') }}>
  // 全局快捷键：按 / 直达搜索
  document.addEventListener('keydown', function (e) {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    var el = document.activeElement;
    var tag = el && el.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (el && el.isContentEditable)) return;
    e.preventDefault();
    var box = document.getElementById('search-input');
    if (box) box.focus();
    else location.href = searchUrl;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 62px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand-mark {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--accent);
    transform: rotate(45deg);
    transition: transform 0.3s ease;
  }

  .brand:hover .brand-mark {
    transform: rotate(135deg);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--bg-soft);
  }

  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* 搜索按钮：和主题切换按钮保持一致的尺寸与手感 */
  .search-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-left: 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-soft);
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .search-link svg {
    width: 17px;
    height: 17px;
  }

  .search-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .search-link.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 680px) {
    .header-inner {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding-block: 12px;
    }

    .nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      padding: 5px 10px;
      font-size: 0.88rem;
    }
  }
</style>
