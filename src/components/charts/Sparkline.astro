---
/**
 * 迷你走势线（纯 SVG，无坐标轴）
 *
 * 用在策略卡片里做一眼可见的趋势提示。
 * 因为它不带刻度和数值，只作为辅助，所以对读屏隐藏；
 * 卡片里另有完整的数值指标，不依赖它传达信息。
 */
interface Props {
  values: number[];
  height?: number;
}

const { values, height = 34 } = Astro.props;

const W = 220;
const PAD = 3;

const min = Math.min(...values);
const max = Math.max(...values);
const span = max - min || 1;
const n = values.length;

const x = (i: number) => PAD + (n <= 1 ? 0 : (i / (n - 1)) * (W - PAD * 2));
const y = (v: number) => PAD + (1 - (v - min) / span) * (height - PAD * 2);

const points = values.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const baseline = y(1);
---

<svg viewBox={`0 0 ${W} ${height}`} class="spark" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <line class="spark-base" x1={PAD} x2={W - PAD} y1={baseline} y2={baseline} />
  <polyline points={points} fill="none" class="spark-line" />
</svg>

<style>
  .spark {
    width: 100%;
    height: 34px;
    display: block;
  }

  .spark-base {
    stroke: var(--border-strong);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }

  .spark-line {
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
</style>
