---
/**
 * 月度收益热力图（纯 SVG）
 *
 * 行 = 年份，列 = 1–12 月，颜色深浅表示收益幅度。
 *
 * 配色遵循中国习惯：**红涨绿跌**。
 * 并且不只靠颜色 —— 每个格子里都带正负号，色觉障碍用户也能读。
 */
import { signedPct } from '../../utils/format';

interface MonthCell {
  y: number;
  m: number;
  r: number;
}

interface Props {
  monthly: MonthCell[];
}

const { monthly } = Astro.props;

const CELL = 46;
const GAP = 4;
const LEFT = 52;
const TOP = 22;
const BOTTOM = 10;

const years = [...new Set(monthly.map((c) => c.y))].sort((a, b) => a - b);
const lookup = new Map(monthly.map((c) => [`${c.y}-${c.m}`, c.r]));

const maxAbs = Math.max(...monthly.map((c) => Math.abs(c.r)), 0.001);

const W = LEFT + 12 * (CELL + GAP);
const H = TOP + years.length * (CELL + GAP) + BOTTOM;

/** 幅度 → 不透明度 */
function alphaOf(r: number): number {
  const t = Math.min(1, Math.abs(r) / maxAbs);
  return Number((0.12 + t * 0.7).toFixed(3));
}

/** 底色深的时候文字反白，否则用正文色 */
function textColor(r: number | undefined): string {
  if (r === undefined) return 'var(--text-mute)';
  return alphaOf(r) > 0.5 ? '#ffffff' : 'var(--text-soft)';
}

const cellX = (m: number) => LEFT + (m - 1) * (CELL + GAP);
const cellY = (yi: number) => TOP + yi * (CELL + GAP);
---

<figure class="chart-figure">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="chart heatmap"
    role="img"
    aria-label="月度收益热力图，红涨绿跌，每格标注百分比"
  >
    <!-- 月份表头 -->
    <g class="head">
      {
        Array.from({ length: 12 }, (_, i) => (
          <text x={cellX(i + 1) + CELL / 2} y={TOP - 8} class="axis-label" text-anchor="middle">
            {i + 1}月
          </text>
        ))
      }
    </g>

    <!-- 年份与单元格 -->
    {
      years.map((year, yi) => (
        <g>
          <text x={LEFT - 12} y={cellY(yi) + CELL / 2 + 4} class="axis-label year-label" text-anchor="end">
            {year}
          </text>
          {Array.from({ length: 12 }, (_, i) => {
            const r = lookup.get(`${year}-${i + 1}`);
            return (
              <g>
                <rect
                  x={cellX(i + 1)}
                  y={cellY(yi)}
                  width={CELL}
                  height={CELL}
                  rx="3"
                  fill={r === undefined ? 'transparent' : r >= 0 ? 'var(--up)' : 'var(--down)'}
                  fill-opacity={r === undefined ? 0 : alphaOf(r)}
                  class="cell-bg"
                />
                <text
                  x={cellX(i + 1) + CELL / 2}
                  y={cellY(yi) + CELL / 2 + 4}
                  class="cell-text"
                  text-anchor="middle"
                  fill={textColor(r)}
                >
                  {r === undefined ? '—' : signedPct(r, 1)}
                </text>
              </g>
            );
          })}
        </g>
      ))
    }
  </svg>

  <figcaption class="legend">
    <span class="legend-item">
      <span class="swatch swatch-down" aria-hidden="true"></span>下跌（绿）
    </span>
    <span class="legend-item">
      <span class="swatch swatch-up-faint" aria-hidden="true"></span>小幅上涨
    </span>
    <span class="legend-item">
      <span class="swatch swatch-up" aria-hidden="true"></span>大幅上涨（红）
    </span>
    <span class="legend-note">每格带正负号，不单靠颜色区分</span>
  </figcaption>
</figure>

<style>
  .chart-figure {
    margin: 0;
  }

  .chart {
    width: 100%;
    height: auto;
    display: block;
  }

  .axis-label {
    fill: var(--text-mute);
    font-size: 11px;
    font-family: var(--font-mono);
  }

  .year-label {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .cell-bg {
    stroke: var(--border);
    stroke-width: 1;
  }

  .cell-text {
    font-size: 11px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .legend {
    display: flex;
    gap: 8px 18px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 12px;
    font-size: 0.78rem;
    color: var(--text-mute);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-note {
    padding-left: 12px;
    border-left: 1px solid var(--border);
  }

  .swatch {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    border: 1px solid var(--border);
    display: inline-block;
  }

  .swatch-up {
    background: var(--up);
  }

  .swatch-up-faint {
    background: var(--up);
    opacity: 0.28;
  }

  .swatch-down {
    background: var(--down);
    opacity: 0.72;
  }
</style>
