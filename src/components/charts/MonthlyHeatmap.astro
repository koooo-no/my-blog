---
/**
 * 月度收益热力图（纯 SVG）
 * 行 = 年份，列 = 1–12 月，颜色深浅表示收益高低。
 */
import { pct } from '../../utils/format';

interface MonthCell {
  y: number;
  m: number;
  r: number;
}

interface Props {
  monthly: MonthCell[];
}

const { monthly } = Astro.props;

const CELL = 46;
const GAP = 4;
const LEFT = 52;
const TOP = 22;
const BOTTOM = 10;

const years = [...new Set(monthly.map((c) => c.y))].sort((a, b) => a - b);
const lookup = new Map(monthly.map((c) => [`${c.y}-${c.m}`, c.r]));

const maxAbs = Math.max(...monthly.map((c) => Math.abs(c.r)), 0.001);

const W = LEFT + 12 * (CELL + GAP);
const H = TOP + years.length * (CELL + GAP) + BOTTOM;

/** 收益 → 背景色：正绿负红，深浅按幅度 */
function heat(r: number | undefined): string {
  if (r === undefined) return 'transparent';
  const t = Math.min(1, Math.abs(r) / maxAbs);
  const alpha = 0.1 + t * 0.72;
  return r >= 0 ? `rgba(47, 93, 80, ${alpha.toFixed(3)})` : `rgba(190, 60, 50, ${alpha.toFixed(3)})`;
}

/** 底色深的时候文字要反白，否则看不清 */
function textColor(r: number | undefined): string {
  if (r === undefined) return 'var(--text-mute)';
  const t = Math.min(1, Math.abs(r) / maxAbs);
  return 0.1 + t * 0.72 > 0.52 ? '#ffffff' : 'var(--text-soft)';
}

const cellX = (m: number) => LEFT + (m - 1) * (CELL + GAP);
const cellY = (yi: number) => TOP + yi * (CELL + GAP);
---

<figure class="chart-figure">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="chart heatmap"
    role="img"
    aria-label="月度收益热力图"
  >
    <!-- 月份表头 -->
    <g class="head">
      {
        Array.from({ length: 12 }, (_, i) => (
          <text x={cellX(i + 1) + CELL / 2} y={TOP - 8} class="axis-label" text-anchor="middle">
            {i + 1}月
          </text>
        ))
      }
    </g>

    <!-- 年份与单元格 -->
    {
      years.map((year, yi) => (
        <g>
          <text x={LEFT - 12} y={cellY(yi) + CELL / 2 + 4} class="axis-label year-label" text-anchor="end">
            {year}
          </text>
          {Array.from({ length: 12 }, (_, i) => {
            const r = lookup.get(`${year}-${i + 1}`);
            return (
              <g>
                <rect
                  x={cellX(i + 1)}
                  y={cellY(yi)}
                  width={CELL}
                  height={CELL}
                  rx="6"
                  fill={heat(r)}
                  class="cell-bg"
                />
                <text
                  x={cellX(i + 1) + CELL / 2}
                  y={cellY(yi) + CELL / 2 + 4}
                  class="cell-text"
                  text-anchor="middle"
                  fill={textColor(r)}
                >
                  {r === undefined ? '—' : pct(r, 1)}
                </text>
              </g>
            );
          })}
        </g>
      ))
    }
  </svg>

  <figcaption class="legend">
    <span class="legend-item">
      <span class="swatch" style="background: rgba(190, 60, 50, 0.78)"></span>亏损
    </span>
    <span class="legend-item">
      <span class="swatch" style="background: rgba(47, 93, 80, 0.16)"></span>小赚
    </span>
    <span class="legend-item">
      <span class="swatch" style="background: rgba(47, 93, 80, 0.82)"></span>大赚
    </span>
  </figcaption>
</figure>

<style>
  .chart-figure {
    margin: 0;
  }

  .chart {
    width: 100%;
    height: auto;
    display: block;
  }

  .axis-label {
    fill: var(--text-mute);
    font-size: 11px;
  }

  .year-label {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .cell-bg {
    stroke: var(--border);
    stroke-width: 1;
  }

  .cell-text {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .legend {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 12px;
    font-size: 0.8rem;
    color: var(--text-mute);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid var(--border);
    display: inline-block;
  }
</style>
