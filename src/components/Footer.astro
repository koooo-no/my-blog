---
import { SITE, SOCIALS, FOOTER_NAV } from '../consts';
import { withBase, stripBase } from '../utils/url';

const year = new Date().getFullYear();
const range = SITE.since === year ? `${year}` : `${SITE.since}–${year}`;

const path = stripBase(Astro.url.pathname).replace(/\/+$/, '') || '/';

function isCurrent(href: string): boolean {
  const clean = href.replace(/\/+$/, '') || '/';
  return clean !== '/' && (path === clean || path.startsWith(clean + '/'));
}
---

<footer class="site-footer">
  <div class="container">
    <!-- 辅助导航：搜索 / 标签 / 归档 / 关于 —— 不占顶部导航位置，但同样可达 -->
    <nav class="footer-nav" aria-label="辅助导航">
      {
        FOOTER_NAV.map((item) => (
          <a href={withBase(item.href)} class:list={[{ current: isCurrent(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="footer-inner">
      <div class="footer-left">
        <p class="copyright">© {range} {SITE.title}</p>
        <p class="built">用 Astro 搭建 · 托管于 GitHub Pages · 无后端</p>
      </div>

      <nav class="socials" aria-label="联系方式">
        {
          SOCIALS.map((s) => (
            <a href={withBase(s.href)} rel="noopener noreferrer">{s.label}</a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding-block: 26px 30px;
    margin-top: 40px;
  }

  /* 与页头呼应的一条细荧光 */
  .site-footer::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent-line) 25%,
      var(--accent-line) 75%,
      transparent
    );
    opacity: 0.4;
    pointer-events: none;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 8px;
    padding-bottom: 18px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .footer-nav a {
    padding: 4px 11px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-size: 0.86rem;
    color: var(--text-soft);
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .footer-nav a.current {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-line);
    font-weight: 500;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .copyright {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .built {
    margin: 3px 0 0;
    font-size: 0.76rem;
    color: var(--text-mute);
  }

  .socials {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .socials a {
    padding: 4px 11px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.84rem;
    color: var(--text-soft);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .socials a:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  @media (max-width: 560px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
