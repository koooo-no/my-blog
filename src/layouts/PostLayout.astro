---
// 文章页布局：标题、日期、标签、正文、上下篇导航
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingTime, isoDate } from '../utils/date';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  /** 原始 markdown 正文，用于估算阅读时间 */
  body?: string;
  /** 上一篇 / 下一篇 */
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
  /** 标题上方的小字，比如"博客" */
  eyebrow?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  body,
  prev,
  next,
  eyebrow,
} = Astro.props;

const minutes = readingTime(body);
const updated = updatedDate && updatedDate.valueOf() !== pubDate.valueOf() ? updatedDate : null;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  tags={tags}
>
  <article class="container-narrow">
    <header class="post-header">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>

      <div class="post-meta meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>约 {minutes} 分钟</span>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>更新于 {formatDate(updated)}</span>
            </>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => (
              <a href={`/tags/${encodeURIComponent(t)}`} class="tag">
                {t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="post-nav" aria-label="文章导航">
      {
        prev ? (
          <a href={prev.href} class="post-nav-item prev">
            <span class="post-nav-label">← 上一篇</span>
            <span class="post-nav-title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={next.href} class="post-nav-item next">
            <span class="post-nav-label">下一篇 →</span>
            <span class="post-nav-title">{next.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 10px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .post-header h1 {
    margin-bottom: 16px;
  }

  .post-meta {
    gap: 8px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .post-nav-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: all 0.15s ease;
  }

  .post-nav-item:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .post-nav-item.next {
    text-align: right;
    grid-column: 2;
  }

  .post-nav-label {
    font-size: 0.76rem;
    color: var(--text-mute);
    letter-spacing: 0.03em;
  }

  .post-nav-title {
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
  }

  .post-nav-item:hover .post-nav-title {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-item.next {
      grid-column: 1;
    }
  }
</style>
